# Copy to .env and replace the placeholders. Never commit .env. See docs/API.md Section 12.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Docker Compose local database settings. These are development-only placeholders.
POSTGRES_DB=indoornav
POSTGRES_USER=indoornav
POSTGRES_PASSWORD=replace-with-a-local-database-password
BACKEND_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/indoornav
DB_USER=indoornav
DB_PASSWORD=replace-with-a-database-password

# Optional: Flyway owner role in hosted environments. Leave these commented out to use
# DB_USER and DB_PASSWORD; setting them to an empty value would override that fallback.
# MIGRATION_DB_USER=replace-with-the-migration-role
# MIGRATION_DB_PASSWORD=replace-with-the-migration-password

ADMIN_USERNAME=admin
# A BCrypt hash (cost 10 or higher) of the administrator password, never the password itself.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Random, at least 32 bytes, different in every environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL_MINUTES=60

SEED_DEMO_DATA=true
SWAGGER_ENABLED=true

# Empty means the floor plans packaged with the backend.
FLOORPLAN_DIR=

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Stair cost multipliers (at least 1) and the route calculation time limit.
ROUTING_AVOID_STAIRS_MULTIPLIER=10
ROUTING_PREFER_ELEVATOR_MULTIPLIER=2
ROUTING_TIMEOUT_SECONDS=10
TRUST_FORWARDED_HEADERS=false
